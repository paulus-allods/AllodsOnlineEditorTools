<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.10" />
      <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.10" />
      <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.10" />
      <PackageReference Include="SixLabors.ImageSharp" Version="3.1.12" />
      <PackageReference Include="Spectre.Console.Cli" Version="0.53.1" />
    </ItemGroup>

    <PropertyGroup>
      <!-- Default: OSS build. Override locally via Directory.Build.local.props
           or pass -p:IsOpenSourceBuild=false to get the full build. -->
      <IsOpenSourceBuild Condition="'$(IsOpenSourceBuild)' == ''">true</IsOpenSourceBuild>
    </PropertyGroup>

    <PropertyGroup Condition="'$(IsOpenSourceBuild)' == 'true'">
      <DefineConstants>$(DefineConstants);IS_OPEN_SOURCE_BUILD</DefineConstants>
    </PropertyGroup>

    <ItemGroup>
      <ProjectReference Include="..\ClientResources\ClientResources.csproj" />
      <ProjectReference Include="..\StructCodeGeneration\StructCodeGeneration.csproj"
                        Condition="'$(IsOpenSourceBuild)' != 'true'" />
    </ItemGroup>

</Project>
